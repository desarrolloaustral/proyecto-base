---
import Client from "../cards/Client.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import { clients } from "../../utils/data.ts";


type ServicesProps = {
    title: string;
    description: string;
    icon: string;
    href: string;
    bg: string;
    target: string;
};


---

<section id="clients">
    <Container className="space-y-10 md:sapce-y-12">
        <div class="text-center max-w-3xl mx-auto space-y-4">
            <Title>
                Nuestros clientes
            </Title>
            <Paragraph>
                Quienes han confiado en nosotros.
            </Paragraph>
        </div>
        <div class="review-containers container-xs">
            
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {
                    clients.map((client: ServicesProps) => {
                    return (
                            <Client title={client.title} description={client.description} icon={client.icon} href={client.href} bg={client.bg} target={client.target}>
                            </Client>
                            );
                    })
            }
        </div>
    </Container>
</section>